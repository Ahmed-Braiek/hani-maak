# Hani Maak environment template
# Never commit real credentials. Copy this file to .env.local for local development.

# Application / demo mode
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data backend
# file = local JSON demo store; supabase = shared server-side state; auto = Supabase when configured.
HANI_DATA_BACKEND=auto
HANI_SUPABASE_STATE_ID=competition-singleton
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred modern server-side secret. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback for older Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=

# Heni Chat / fine-tuned-model-ready configuration
# development keeps the deterministic competition path. openai enables the server-side model provider.
HENI_AI_PROVIDER=development
HENI_CHAT_MODEL=gpt-5.6-terra
# Set this only after a validated fine-tuned model exists. It takes precedence over HENI_CHAT_MODEL.
HENI_FINE_TUNED_MODEL_ID=
HENI_FALLBACK_MODEL=
HENI_AI_API_KEY=
HENI_AI_BASE_URL=https://api.openai.com/v1
HENI_MAX_OUTPUT_TOKENS=220
HENI_MODEL_TIMEOUT_MS=12000

# Voice / realtime AI bridge
VOICE_BRIDGE_WSS_URL=
VOICE_BRIDGE_SHARED_SECRET=
HANI_WEB_BASE_URL=http://localhost:3000
VOICE_BRIDGE_PORT=8787
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Backward-compatible legacy values. Prefer OPENAI_REALTIME_MODEL for new environments.
OPENAI_LIVE_MODEL=
OPENAI_DELEGATED_MODEL=gpt-5.6-terra
OPENAI_VOICE=marin

# Optional bounded medicine-package text extraction
OPENAI_VISION_MODEL=gpt-5.6-terra

# Maps
# If omitted, the app uses the existing key-free OpenStreetMap context where available.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Notifications
ENABLE_EXTERNAL_NOTIFICATIONS=false
RESEND_API_KEY=
RESEND_FROM=Hani Maak <noreply@example.com>
TWILIO_SMS_FROM=

# Competition mode - no external services required for the core web demo.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Mapbox. If omitted, the app uses a key-free OpenStreetMap embed + local indoor route layer.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Supabase competition backend. Run supabase/competition-state.sql first.
# file = zero-config local JSON; supabase = server-side shared competition state; auto = Supabase when configured.
HANI_DATA_BACKEND=auto
HANI_SUPABASE_STATE_ID=competition-singleton
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may call the public key an anon key; the competition state adapter does not require it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional live telephony / AI voice bridge.
VOICE_BRIDGE_WSS_URL=
VOICE_BRIDGE_SHARED_SECRET=change-me-for-live-demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Legacy Live variables are retained only for backwards compatibility.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_DELEGATED_MODEL=gpt-5.6-terra
OPENAI_VOICE=marin
OPENAI_VISION_MODEL=gpt-5.6-terra
HANI_WEB_BASE_URL=http://localhost:3000
VOICE_BRIDGE_PORT=8787

# Optional notification provider adapter.
ENABLE_EXTERNAL_NOTIFICATIONS=false
RESEND_API_KEY=
RESEND_FROM=Hani Maak <noreply@example.com>
TWILIO_SMS_FROM=

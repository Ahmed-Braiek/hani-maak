# Runtime
HENI_ENV=development
PORT=8080

# Google Gemini API (fastest competition setup)
GEMINI_API_KEY=
HENI_TEXT_MODEL=gemini-3.8-flash
HENI_LIVE_MODEL=gemini-3.8-live
HENI_VOICE_NAME=Gacrux

# Optional Vertex AI mode. Use proper Google Cloud workload identity / ADC in production.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Hani Maak backend integration
HANI_BACKEND_BASE_URL=https://hani-maak.vercel.app
HENI_AGENT_SHARED_SECRET=
HENI_ALLOWED_ORIGINS=http://localhost:3000,https://hani-maak.vercel.app
HENI_BACKEND_TIMEOUT_SECONDS=12

# Development only
HENI_DEBUG=false
HENI_SESSION_TTL_SECONDS=1800
